<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RegistroAsistencia"
             x:Class="RegistroAsistencia.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            
            <Color x:Key="PrimaryColor">#1E6FA8</Color>

            <Color x:Key="SecondaryColor">#751805</Color>

            <Color x:Key="TertiaryColor">#938d6b</Color>
            
            <Color x:Key="PageBackgroundColor">#F8F9FA</Color>
            <Color x:Key="LightBackgroundColor">#FFFFFF</Color>
            <Color x:Key="PrimaryTextColor">#202124</Color>
            <Color x:Key="SecondaryTextColor">#5F6368</Color>
            <Color x:Key="TertiaryTextColor">#9AA0A6</Color>
            <Color x:Key="BorderColor">#DADCE0</Color>

            
            

        </ResourceDictionary>
    </Application.Resources>
</Application>